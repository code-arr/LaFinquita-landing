# Copiá este archivo como .env.local para probar en tu compu.
# En producción, cargá las mismas variables en Vercel → Settings → Environment Variables.

# dLocal Go — claves del dashboard (Integrations → API Integration)
# sandbox: https://dashboard-sbx.dlocalgo.com   ·   producción: https://dashboard.dlocalgo.com
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
DLOCALGO_ENV=sandbox

# PayPal — compradores de EE.UU., Europa y resto del mundo (dLocal Go sólo cobra a Latinoamérica)
# developer.paypal.com → Apps & Credentials (sandbox) · producción: la cuenta Business de La Finquita
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Firma de los QR — un texto largo al azar (no lo compartas ni lo cambies una vez que se vende)
TICKET_SECRET=

# PIN para validar.html (staff en la puerta) y admin.html (ventas)
STAFF_PIN=
ADMIN_PIN=

# Tu comisión (sólo para mostrar el cálculo en admin.html), ej: 10
COMISION_PCT=10

# Email (https://resend.com). Sin clave, sólo se loguea (modo desarrollo).
# Sólo se usa para AVISARLE A LA ENCARGADA cada venta (al cliente no se le manda mail).
# Creá la cuenta de Resend con el MISMO mail de la encargada (EMAIL_ENCARGADA): así Resend
# deja enviar a esa casilla sin verificar dominio, usando el remitente compartido onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=La Finquita 1920 <onboarding@resend.dev>
# A quién le llega el aviso de cada venta de extranjeros (la encargada que carga y manda las entradas por Venti)
EMAIL_ENCARGADA=

# URL pública (en producción): https://lafinquita1920.com.ar
SITE_URL=

# Base de datos: Upstash Redis (Vercel → Storage → Upstash → Connect, completa esto solo)
KV_REST_API_URL=
KV_REST_API_TOKEN=
